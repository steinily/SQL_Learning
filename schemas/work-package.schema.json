{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Work Package",
  "type":"object",
  "required":["schema_version","id","title","state","manifest_items","completion_criteria"],
  "properties":{
    "schema_version":{"const":1},
    "id":{"type":"string","pattern":"^WP-[A-Z0-9]+-[0-9]{3}$"},
    "title":{"type":"string"},
    "state":{"enum":["PLANNED","READY","RESEARCHING","WRITING","VALIDATING","REWORK","REVIEW","DONE","BLOCKED"]},
    "manifest_items":{"type":"array","minItems":1,"items":{"type":"string"}},
    "dependencies":{"type":"array","items":{"type":"string"}},
    "research_requirements":{"type":"array","items":{"type":"string"}},
    "validation_requirements":{"type":"array","items":{"type":"string"}},
    "completion_criteria":{"type":"array","minItems":1,"items":{"type":"string"}},
    "rework_cycles":{"type":"integer","minimum":0,"maximum":3}
  },
  "additionalProperties":false
}