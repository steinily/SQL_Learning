{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Validation Report",
  "type":"object",
  "required":["schema_version","document_id","run_id","dimensions","findings"],
  "properties":{
    "schema_version":{"const":1},
    "document_id":{"type":"string"},
    "run_id":{"type":"string"},
    "document_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "dimensions":{"type":"object","additionalProperties":{"enum":["PASS","FAIL","N/A","NOT_RUN","BLOCKED"]}},
    "findings":{"type":"array","items":{"type":"object","required":["severity","message"],"properties":{
      "severity":{"enum":["BLOCKER","CRITICAL","MAJOR","MINOR","INFO"]},
      "code":{"type":"string"},
      "message":{"type":"string"},
      "evidence":{"type":"string"}
    },"additionalProperties":false}},
    "executed_at":{"type":"string","format":"date-time"}
  },
  "additionalProperties":false
}
