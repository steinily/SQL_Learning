{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-glossary.local/schemas/document.schema.json",
  "title": "Knowledge Base Document Metadata",
  "type": "object",
  "required": ["schema_version","id","title","type","primary_domain","levels","status","maturity","verification","publish"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type":"string","pattern":"^DBKB-[A-Z0-9]+-[0-9]{4}$"},
    "title": {"type":"string","minLength":1},
    "type": {"enum":["overview","concept","technology","reference","tutorial","recipe","troubleshooting","error","case-study","comparison","cheatsheet","exercise","learning-path","playbook"]},
    "primary_domain": {"type":"string","minLength":1},
    "secondary_domains": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "levels": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["beginner","intermediate","advanced","expert"]}},
    "status": {"enum":["planned","researching","draft","content_complete","qa_in_progress","verify_required","source_conflict","rework","verified","deprecated","blocked"]},
    "maturity": {"enum":["stub","draft","complete","mature"]},
    "verification": {"enum":["unverified","source-verified","syntax-verified","execution-verified","fully-verified"]},
    "publish": {"type":"boolean","default":false},
    "technologies": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "sql_dialects": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "scope": {"enum":["general","sql-standard","portable-sql","vendor-specific","cross-vendor"]},
    "prerequisites": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "related": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "aliases": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "search_keywords": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "risk": {"enum":["safe","caution","destructive","production-critical","security-sensitive"]},
    "version_sensitive": {"type":"boolean"},
    "review_cycle": {"enum":["6m","12m","24m","on-major-release"]},
    "acceptance_criteria": {"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": false
}